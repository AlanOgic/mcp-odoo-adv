# Odoo MCP Server — Streamable HTTP transport
# Build: docker build -t alanogic/mcp-odoo-adv:http -f Dockerfile.http .
# Run:   docker run -p 8008:8008 --env-file .env alanogic/mcp-odoo-adv:http
#
# NOTE: this image runs the UNAUTHENTICATED HTTP runner. The process binds
# to 127.0.0.1 by default — set MCP_HOST=0.0.0.0 only when behind an auth
# layer (nginx + token), or use Dockerfile.http-secure for built-in Bearer auth
# (that image is the recommended way to expose this server on a network).

ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim

WORKDIR /app

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir "fastmcp[cli]>=2.12.0" requests python-dotenv

COPY src/ ./src/
RUN pip install --no-cache-dir -e .

RUN mkdir -p /app/logs && chmod 777 /app/logs

EXPOSE 8008
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["odoo-mcp-http"]
