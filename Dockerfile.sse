# Odoo MCP Server — SSE transport
# Build: docker build -t alanogic/mcp-odoo-adv:sse -f Dockerfile.sse .
# Run:   docker run -p 8009:8009 --env-file .env alanogic/mcp-odoo-adv:sse
#
# NOTE: this runner is UNAUTHENTICATED and binds to 127.0.0.1 by default.
# Set MCP_HOST=0.0.0.0 only when placed behind an auth layer.

ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim

WORKDIR /app

COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir "fastmcp[cli]>=2.12.0" requests python-dotenv

COPY src/ ./src/
RUN pip install --no-cache-dir -e .

RUN mkdir -p /app/logs && chmod 777 /app/logs

EXPOSE 8009
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["odoo-mcp-sse"]
